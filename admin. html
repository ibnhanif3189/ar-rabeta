    "#arr-receipt-root .arr-sign div{min-width:190px;text-align:center}",
    "#arr-receipt-root .arr-sign .nm{font-family:'Noto Serif Bengali',serif;font-style:italic;font-size:1.15rem;min-height:34px}",
    "#arr-receipt-root .arr-sign img{max-height:46px;max-width:180px}",
    "#arr-receipt-root .arr-sign .ln{border-top:1px solid #16241F;padding-top:4px;font-size:.88rem;color:#55665F}",
    "#arr-receipt-root .arr-foot{margin-top:18px;text-align:center;color:#55665F;font-size:.8rem}",
    "@media print{",
    "html,body{background:#fff!important;color:#000}",
    "body>*:not(#arr-receipt-root){display:none!important}",
    "#arr-receipt-root{position:static;background:none;padding:0;overflow:visible}",
    "#arr-receipt-root .arr-actions{display:none!important}",
    "#arr-receipt-root .arr-paper{border-radius:0;max-width:none}",
    "@page{margin:14mm}",
    "}"
  ].join("\n");

  var nf = new Intl.NumberFormat("bn-BD", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  var dayFmt = new Intl.DateTimeFormat("bn-BD", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
  var monthFmt = new Intl.DateTimeFormat("bn-BD", { month: "long", year: "numeric", timeZone: "UTC" });
  var TYPES = {
    deposit: { title: "জমার রসিদ", label: "সদস্য জমা" },
    expense: { title: "খরচের ভাউচার", label: "খরচ" },
    investment: { title: "বিনিয়োগের ভাউচার", label: "বিনিয়োগ" }
  };

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text != null) e.textContent = text;
    return e;
  }

  function close() {
    var r = document.getElementById(ROOT_ID);
    if (r) r.parentNode.removeChild(r);
    document.removeEventListener("keydown", onKey);
  }
  function onKey(e) { if (e.key === "Escape") close(); }

  function addRow(tbody, k, v) {
    if (!v) return;
    var tr = el("tr");
    tr.appendChild(el("th", null, k));
    tr.appendChild(el("td", null, v));
    tbody.appendChild(tr);
  }

  function show(r) {
    close();
    if (!document.getElementById(STYLE_ID)) {
      var st = el("style");
      st.id = STYLE_ID;
      st.textContent = CSS;
      document.head.appendChild(st);
    }
    var t = TYPES[r.type] || { title: "রসিদ", label: r.type };

    var root = el("div");
    root.id = ROOT_ID;
    root.setAttribute("role", "dialog");
    root.setAttribute("aria-modal", "true");
    root.setAttribute("aria-label", t.title);

    var actions = el("div", "arr-actions");
    var pbtn = el("button", "arr-print", "প্রিন্ট / PDF সংরক্ষণ");
    pbtn.type = "button";
    pbtn.addEventListener("click", function () { window.print(); });
    var cbtn = el("button", "arr-close", "বন্ধ করুন");
    cbtn.type = "button";
    cbtn.addEventListener("click", close);
    actions.appendChild(pbtn);
    actions.appendChild(cbtn);
    root.appendChild(actions);

    var paper = el("div", "arr-paper");

    var head = el("div", "arr-head");
    var img = el("img");
    img.src = LOGO;
    img.alt = "আর-রাবেতা";
    head.appendChild(img);
    head.appendChild(el("div", "arr-title", t.title));
    if (r.is_reversal) head.appendChild(el("div", "arr-badge", "সংশোধনী এন্ট্রি (আগের এন্ট্রি বাতিল)"));
    paper.appendChild(head);

    var meta = el("div", "arr-meta");
    var a = el("span", null, "রসিদ নম্বর: ");
    a.appendChild(el("b", null, r.receipt_no));
    var b = el("span", null, "তারিখ: ");
    b.appendChild(el("b", null, dayFmt.format(new Date(r.date + "T00:00:00Z"))));
    meta.appendChild(a);
    meta.appendChild(b);
    paper.appendChild(meta);

    var table = el("table", "arr-rows");
    var tb = el("tbody");
    addRow(tb, "ধরন", t.label);
    addRow(tb, "সদস্য আইডি", r.member_no);
    addRow(tb, "সদস্যের নাম", r.member_name);
    
    if (r.periods && r.periods.length > 0) {
      var trP = el("tr");
      trP.appendChild(el("th", null, "মাস ও পরিমাণ"));
      var tdP = el("td");
      var tTable = el("table");
      tTable.style.width = "100%";
      tTable.style.borderCollapse = "collapse";
      r.periods.forEach(function(p) {
        var pTr = el("tr");
        var pTd1 = el("td", null, monthFmt.format(new Date(p.month + "T00:00:00Z")));
        var pTd2 = el("td", null, "৳ " + nf.format(p.amount));
        pTd2.style.textAlign = "right";
        pTr.appendChild(pTd1); pTr.appendChild(pTd2);
        tTable.appendChild(pTr);
      });
      tdP.appendChild(tTable);
      trP.appendChild(tdP);
      tb.appendChild(trP);
    } else if (r.month) {
      addRow(tb, "কোন মাসের জমা", monthFmt.format(new Date(r.month + "T00:00:00Z")));
    }
    
    addRow(tb, "খাত", r.category);
    addRow(tb, "বিবরণ", r.description);
    addRow(tb, "রেফারেন্স", r.reference);
    table.appendChild(tb);
    paper.appendChild(table);

    var amt = el("div", "arr-amount");
    amt.appendChild(el("span", null, "টাকার পরিমাণ"));
    amt.appendChild(el("strong", null, "৳ " + nf.format(Number(r.amount))));
    paper.appendChild(amt);

    var sign = el("div", "arr-sign");
    var box = el("div");
    if (window.ARReceipt && window.ARReceipt.signatureImage) {
      var si = el("img");
      si.src = window.ARReceipt.signatureImage;
      si.alt = "স্বাক্ষর";
      box.appendChild(si);
    } else {
      box.appendChild(el("div", "nm", "Tanvir"));
    }
    box.appendChild(el("div", "ln", "ফিন্যান্স এডিটর"));
    sign.appendChild(box);
    paper.appendChild(sign);

    paper.appendChild(el("div", "arr-foot", "এই রসিদ আর-রাবেতা হিসাব ব্যবস্থা থেকে তৈরি।"));

    root.appendChild(paper);
    document.body.appendChild(root);
    document.addEventListener("keydown", onKey);
    root.scrollTop = 0;
    pbtn.focus();
  }

  window.ARReceipt = { show: show, close: close, signatureImage: null };
})();

</script>
<script>
"use strict";
var SUPA = "https://ldwcbppzawnhrmlxajre.supabase.co";
var API = SUPA + "/functions/v1/ar-rabeta-api";

var token = null;
var logoutTimer = null;
var members = [];
var toastTimer = null;
var editingMemberId = null;
var editingTxNo = null;

function $(id) { return document.getElementById(id); }
function store(k, v) {
  try {
    if (v === undefined) return localStorage.getItem(k);
    localStorage.setItem(k, v);
  } catch (e) { return null; }
}
function en(s) { return String(s == null ? "" : s).replace(/[০-৯]/g, function (d) { return "০১২৩৪৫৬৭৮৯".indexOf(d); }); }
var nf = new Intl.NumberFormat("bn-BD", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
function taka(n) { return "৳ " + nf.format(Number(n) || 0); }
function todayStr() { var d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); }
function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
function toast(msg, bad) { var t = $("toast"); t.textContent = msg; t.className = "toast" + (bad ? " bad" : ""); t.hidden = false; clearTimeout(toastTimer); toastTimer = setTimeout(function () { t.hidden = true; }, 4500); }

async function api(path, opts) {
  opts = opts || {};
  var r;
  try {
    r = await fetch(API + path, {
      method: opts.method || "GET",
      headers: { "Content-Type": "application/json", "Authorization": "Bearer " + token },
      body: opts.body ? JSON.stringify(opts.body) : undefined
    });
  } catch (e) { throw new Error("ইন্টারনেট সংযোগ দেখুন"); }
  var d = {};
  try { d = await r.json(); } catch (e) { /* ignore */ }
  if (r.status === 401) { logout("সেশন শেষ, আবার লগইন করুন"); throw new Error("সেশন শেষ"); }
  if (!r.ok || d.success === false) throw new Error(d.error || "কিছু একটা ভুল হয়েছে");
  return d;
}

var savedKey = store("arr_key");
if (!savedKey) $("setup").open = true;

$("loginForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var btn = $("loginBtn");
  btn.disabled = true;
  $("loginErr").textContent = "";
  try {
    var key = $("key").value.trim() || store("arr_key");
    if (!key) { $("setup").open = true; throw new Error("Publishable key দিন"); }
    var r = await fetch(SUPA + "/auth/v1/token?grant_type=password", {
      method: "POST", headers: { "Content-Type": "application/json", "apikey": key },
      body: JSON.stringify({ email: $("email").value.trim(), password: $("password").value })
    });
    var d = {};
    try { d = await r.json(); } catch (je) { /* ignore */ }
    if (!r.ok || !d.access_token) throw new Error(r.status === 400 ? "ইমেইল বা পাসওয়ার্ড সঠিক নয়" : "লগইন করা যায়নি");
    token = d.access_token;
    var ping = await fetch(API + "/admin/ping", { headers: { "Authorization": "Bearer " + token } });
    if (!ping.ok) { token = null; throw new Error("এই অ্যাকাউন্টের অ্যাডমিন অনুমতি নেই"); }
    store("arr_key", key);
    $("password").value = "";
    startApp(d.expires_in || 3600);
  } catch (err) { $("loginErr").textContent = err.message; } finally { btn.disabled = false; }
});

function startApp(expiresIn) {
  $("loginView").hidden = true; $("appView").hidden = false;
  clearTimeout(logoutTimer);
  logoutTimer = setTimeout(function () { logout("সেশনের সময় শেষ"); }, Math.max(60, expiresIn - 30) * 1000);
  $("tDate").value = todayStr(); $("tMonth").value = todayStr().slice(0, 7); $("mJoin").value = todayStr();
  switchTab("summary"); loadAll();
}

function logout(msg) {
  token = null; members = []; clearTimeout(logoutTimer);
  $("appView").hidden = true; $("loginView").hidden = false;
  $("codeBox").hidden = true; $("txResult").hidden = true;
  $("loginErr").textContent = msg || "";
}
$("logoutBtn").addEventListener("click", function () { logout(""); });

function switchTab(name) {
  ["summary", "tx", "members"].forEach(function (t) { $("tab-" + t).hidden = (t !== name); });
  document.querySelectorAll("nav.tabs button").forEach(function (b) {
    if (b.dataset.tab === name) b.setAttribute("aria-current", "page"); else b.removeAttribute("aria-current");
  });
  window.scrollTo(0, 0);
}
document.querySelectorAll("nav.tabs button").forEach(function (b) { b.addEventListener("click", function () { switchTab(b.dataset.tab); }); });

async function loadAll() {
  try {
    var res = await Promise.all([api("/admin/summary"), api("/admin/members"), api("/admin/transactions")]);
    renderSummary(res[0]); members = res[1].members || []; renderMembers(); renderTx(res[2].transactions || []);
  } catch (e) { if (token) toast(e.message, true); }
}
$("refreshBtn").addEventListener("click", loadAll);

function renderSummary(d) {
  $("sDeposit").textContent = taka(d.total_deposits); $("sExpense").textContent = taka(d.total_expenses);
  $("sInvest").textContent = taka(d.total_investments);
  var b = $("sBalance"); b.textContent = taka(d.balance); b.classList.toggle("neg", Number(d.balance) < 0);
  $("sMembers").textContent = "সক্রিয় স্থায়ী সদস্য: " + nf.format(d.active_fixed_members || 0) + " জন";
}

function renderMembers() {
  var ul = $("memberList"); ul.textContent = "";
  if (!members.length) ul.appendChild(el("li", "empty", "এখনো কোনো সদস্য নেই।"));
  
  members.forEach(function (m) {
    var li = el("li");
    if (m.photo_url) {
      var img = el("img", "avatar"); img.src = m.photo_url; li.appendChild(img);
    } else {
      var av = el("div", "avatar"); av.style.background = "#ccc"; li.appendChild(av);
    }

    var details = el("div", "details");
    var top = el("div", "name", (m.member_no ? "[" + m.member_no + "] " : "") + m.full_name);
    top.appendChild(el("span", "tag" + (m.member_type === "fixed" ? " fixed" : ""), m.member_type === "fixed" ? "স্থায়ী" : "অন্যান্য"));
    if (!m.active) top.appendChild(el("span", "tag", "নিষ্ক্রিয়"));
    details.appendChild(top);

    var sub = el("div", "sub");
    sub.appendChild(el("span", null, "ফোন: " + (m.phone || "নেই")));
    sub.appendChild(el("span", null, "মাসিক সঞ্চয়: " + taka(m.monthly_savings)));
    details.appendChild(sub);
    li.appendChild(details);

    var actions = el("div", "actions");
    var btnEdit = el("button", "mini", "এডিট"); btnEdit.type = "button";
    btnEdit.addEventListener("click", function () { editMember(m); });
    actions.appendChild(btnEdit);

    if (m.member_type === "fixed") {
      var btnCode = el("button", "mini danger", "কোড রিসেট"); btnCode.type = "button";
      btnCode.addEventListener("click", function () { resetCode(m); });
      actions.appendChild(btnCode);
    }
    li.appendChild(actions);
    ul.appendChild(li);
  });

  var sel = $("tMember"); sel.textContent = "";
  var act = members.filter(function (m) { return m.active; });
  act.forEach(function (m) { var o = el("option", null, (m.member_no ? m.member_no + " - " : "") + m.full_name); o.value = m.id; sel.appendChild(o); });
}

function editMember(m) {
  editingMemberId = m.id;
  $("memberFormTitle").textContent = "সদস্য এডিট করুন";
  $("mPhotoHint").hidden = false;
  $("mName").value = m.full_name;
  document.querySelector('input[name="mtype"][value="' + m.member_type + '"]').checked = true;
  $("mPhone").value = m.phone || ""; $("mAddress").value = m.address || "";
  $("mJob").value = m.occupation || ""; $("mSavings").value = m.monthly_savings || 0;
  $("mJoin").value = m.join_date;
  $("memberPanel").open = true;
  window.scrollTo(0, 0);
}

async function resetCode(m) {
  if (!confirm(m.full_name + " এর নতুন কোড তৈরি করবেন? পুরনো কোডটি বাতিল হয়ে যাবে।")) return;
  try {
    var d = await api("/admin/members/" + m.id + "/reset-code", { method: "POST" });
    var box = $("codeBox");
    $("codeTitle").textContent = m.full_name + " এর নতুন লগইন কোড";
    $("codeVal").textContent = d.code;
    $("codeNote").textContent = "এই কোড আর কখনো দেখা যাবে না। এখনই সদস্যকে জানিয়ে দিন।";
    box.hidden = false; box.scrollIntoView({ block: "start" });
  } catch (e) { toast(e.message, true); }
}

$("memberForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var btn = $("mBtn"); $("mErr").textContent = "";
  var type = document.querySelector('input[name="mtype"]:checked').value;
  
  var fileInput = $("mPhoto");
  var photo_base64 = null;
  
  if (fileInput.files.length > 0) {
    var file = fileInput.files[0];
    if (file.size > 1024 * 1024) { $("mErr").textContent = "ছবির সাইজ ১ MB এর কম হতে হবে"; return; }
    photo_base64 = await new Promise(function(resolve) {
      var reader = new FileReader(); reader.onloadend = function() { resolve(reader.result); }; reader.readAsDataURL(file);
    });
  }

  var body = {
    full_name: $("mName").value.trim(), member_type: type, phone: en($("mPhone").value).trim(),
    address: $("mAddress").value.trim(), occupation: $("mJob").value.trim(),
    monthly_savings: en($("mSavings").value).trim(), join_date: $("mJoin").value,
    photo_base64: photo_base64
  };
  
  btn.disabled = true;
  try {
    var d;
    if (editingMemberId) {
      d = await api("/admin/members/" + editingMemberId, { method: "PUT", body: body });
      toast("সদস্য আপডেট হয়েছে"); editingMemberId = null;
      $("memberFormTitle").textContent = "নতুন সদস্য যোগ করুন";
      $("mPhotoHint").hidden = true;
    } else {
      d = await api("/admin/members", { method: "POST", body: body });
      if (d.code) {
        $("codeTitle").textContent = d.member.full_name + " এর লগইন কোড";
        $("codeVal").textContent = d.code;
        $("codeNote").textContent = "এই কোড আর কখনো দেখা যাবে না। লগইনে কোডের সাথে ফোনের শেষ ৪ ডিজিটও লাগবে।";
        $("codeBox").hidden = false; $("codeBox").scrollIntoView({ block: "start" });
      }
      toast("সদস্য যোগ হয়েছে");
    }
    $("memberForm").reset(); $("mJoin").value = todayStr(); $("memberPanel").open = false; loadAll();
  } catch (err) { $("mErr").textContent = err.message; } finally { btn.disabled = false; }
});

function syncTxFields() {
  var t = document.querySelector('input[name="ttype"]:checked').value;
  var dep = t === "deposit";
  $("fMember").hidden = !dep; $("fDepositType").hidden = !dep; $("fCategory").hidden = dep;
  if (dep) { toggleDepositMode(); $("singleMonthBox").hidden = true; $("multiMonthBox").hidden = true; }
  else {
    if (t === "expense") { $("tCategoryLbl").textContent = "খরচের খাত"; }
    if (t === "investment") { $("tCategoryLbl").textContent = "বিনিয়োগের ধরন"; }
  }
}
function toggleDepositMode() {
  var mode = document.querySelector('input[name="dtype"]:checked').value;
  $("singleMonthBox").hidden = (mode !== "single");
  $("multiMonthBox").hidden = (mode !== "multi");
  if (mode === "multi" && $("multiMonthTable").querySelector("tbody").children.length === 0) {
    addMonthRow();
  }
  calcTotal();
}
function addMonthRow() {
  var tr = el("tr");
  tr.innerHTML = '<td><input type="month" class="m-month" required></td><td><input type="number" class="m-amount" placeholder="0" required></td>';
  $("multiMonthTable").querySelector("tbody").appendChild(tr);
  tr.querySelector(".m-amount").addEventListener("input", calcTotal);
}
function calcTotal() {
  var mode = document.querySelector('input[name="dtype"]:checked').value;
  if (mode === "multi") {
    var total = 0;
    document.querySelectorAll(".m-amount").forEach(function(inp) { total += parseFloat(inp.value) || 0; });
    $("tAmount").value = total;
    $("multiTotal").textContent = taka(total);
  } else {
    $("tAmount").value = "";
    $("tAmount").readOnly = false;
  }
}
document.querySelectorAll('input[name="ttype"]').forEach(function (r) { r.addEventListener("change", syncTxFields); });
document.querySelectorAll('input[name="dtype"]').forEach(function (r) { r.addEventListener("change", toggleDepositMode); });
$("addMonthBtn").addEventListener("click", addMonthRow);
syncTxFields();

$("txForm").addEventListener("submit", async function (e) {
  e.preventDefault();
  var btn = $("txBtn"); $("txErr").textContent = ""; $("txResult").hidden = true;
  var type = document.querySelector('input[name="ttype"]:checked').value;
  var body = { type: type, amount: en($("tAmount").value).trim(), date: $("tDate").value, description: $("tDesc").value.trim(), reference: $("tRef").value.trim() };
  
  if (type === "deposit") {
    body.member_id = $("tMember").value;
    var mode = document.querySelector('input[name="dtype"]:checked').value;
    if (mode === "single") {
      body.contribution_month = $("tMonth").value;
      if (!body.contribution_month) { $("txErr").textContent = "কোন মাসের জমা তা দিন"; return; }
    } else {
      body.periods = [];
      document.querySelectorAll("#multiMonthTable tbody tr").forEach(function(tr) {
        var m = tr.querySelector(".m-month").value;
        var a = tr.querySelector(".m-amount").value;
        if (m && a) body.periods.push({ month: m, amount: parseFloat(a) });
      });
      if (!body.periods.length) { $("txErr").textContent = "মাস এবং টাকার পরিমাণ দিন"; return; }
    }
  } else {
    body.category = $("tCategory").value.trim();
    if (body.category.length < 2) { $("txErr").textContent = "খাত বা ধরন লিখুন"; return; }
  }

  btn.disabled = true;
  try {
    var d = await api("/admin/transactions", { method: "POST", body: body });
    $("txReceipt").textContent = d.transaction.receipt_no; lastReceiptNo = d.transaction.receipt_no;
    $("txResult").hidden = false; $("txResult").scrollIntoView({ block: "start" });
    toast("লেনদেন সংরক্ষণ হয়েছে");
    $("txForm").reset(); $("tAmount").value = ""; $("tDate").value = todayStr();
    loadAll();
  } catch (err) { $("txErr").textContent = err.message; } finally { btn.disabled = false; }
});

function renderTx(rows) {
  var ul = $("txList"); ul.textContent = "";
  if (!rows.length) ul.appendChild(el("li", "empty", "কোনো লেনদেন নেই।"));
  var TYPE_BN = { deposit: "জমা", expense: "খরচ", investment: "বিনিয়োগ" };
  rows.forEach(function (r) {
    var li = el("li", "tx" + (r.is_reversal ? " rev" : ""));
    var left = el("div"); left.style.flex = "1";
    var who = r.member_name || r.category || "";
    left.appendChild(el("div", "name", (TYPE_BN[r.type] || r.type) + (who ? ": " + who : "")));
    left.appendChild(el("div", "sub", r.date + ", " + taka(r.amount) + ", " + r.receipt_no));
    li.appendChild(left);
    
    var actions = el("div", "actions");
    var bView = el("button", "mini", "রসিদ"); bView.type = "button";
    bView.addEventListener("click", function () { openReceipt(r.receipt_no); });
    actions.appendChild(bView);

    var bEdit = el("button", "mini", "এডিট"); bEdit.type = "button";
    bEdit.addEventListener("click", function() { alert("বিবরণ বা রেফারেন্স এডিট করার অপশন পরবর্তী ধাপে আসবে।"); });
    actions.appendChild(bEdit);

    li.appendChild(actions);
    ul.appendChild(li);
  });
}

var lastReceiptNo = "";
async function openReceipt(no) {
  try {
    var d = await api("/admin/receipt?no=" + encodeURIComponent(no));
    window.ARReceipt.show(d.receipt);
  } catch (e) { if (token) toast(e.message, true); }
}
$("txOpen").addEventListener("click", function () { openReceipt(lastReceiptNo); });

$("copyCode").addEventListener("click", async function () {
  try { await navigator.clipboard.writeText($("codeVal").textContent); toast("কোড কপি হয়েছে"); } 
  catch (e) { toast("কপি হয়নি, হাতে লিখে নিন", true); }
});
</script>
</body>
</html>
