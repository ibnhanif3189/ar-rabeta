<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="color-scheme" content="light dark">
<title>আর-রাবেতা অ্যাডমিন</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600&family=Noto+Serif+Bengali:wght@500;700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #F2F5F1; --surface: #FFFFFF; --ink: #16241F; --muted: #55665F;
  --line: #C9D3CC; --accent: #0E6B52; --accent-ink: #FFFFFF; --brass: #8A6518;
  --danger: #B3402A; --focus: #0E6B52;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
  :root {
    --paper: #0F1A16; --surface: #16231E; --ink: #E7EEE9; --muted: #9BAEA5;
    --line: #2A3B34; --accent: #3FB08C; --accent-ink: #06150F; --brass: #D2A94A;
    --danger: #E0735C; --focus: #3FB08C;
  }
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Noto Sans Bengali", system-ui, sans-serif; font-size: 16px; line-height: 1.6; padding: env(safe-area-inset-top, 0px) 0 calc(76px + env(safe-area-inset-bottom, 0px)); }
h1, h2, h3 { font-family: "Noto Serif Bengali", serif; line-height: 1.3; margin: 0; }
h2 { font-size: 1.25rem; margin-bottom: 12px; }
h3 { font-size: 1.05rem; }
.wrap { max-width: 560px; margin: 0 auto; padding: 0 16px; }
button, input, select, textarea { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }

.top { display: flex; align-items: center; justify-content: space-between; padding: 18px 0 10px; }
.brand { font-family: "Noto Serif Bengali", serif; font-weight: 700; font-size: 1.5rem; }
.brand small { display: block; font-family: "Noto Sans Bengali", sans-serif; font-weight: 400; font-size: .85rem; color: var(--muted); }
.link-btn { background: none; border: 0; color: var(--muted); text-decoration: underline; padding: 10px 4px; cursor: pointer; min-height: 44px; }

.ledger { margin: 8px 0 28px; }
.ledger .row { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 2px; border-bottom: 1px solid var(--line); }
.ledger .row span:first-child { color: var(--muted); }
.ledger .num { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 1.1rem; }
.ledger .total { border-top: 4px double var(--ink); border-bottom: 0; padding-top: 18px; margin-top: 4px; }
.ledger .total span:first-child { color: var(--ink); font-weight: 600; }
.ledger .total .num { font-family: "Noto Serif Bengali", serif; font-size: 1.9rem; color: var(--accent); }
.ledger .total .num.neg { color: var(--danger); }
.ledger-note { color: var(--muted); font-size: .9rem; margin: 10px 2px 0; }

.panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin-bottom: 22px; }
.field { margin-bottom: 14px; }
label, .lbl { display: block; font-weight: 500; margin-bottom: 4px; }
.hint { color: var(--muted); font-size: .88rem; margin-top: 3px; }
input[type=text], input[type=email], input[type=password], input[type=tel], input[type=date], input[type=month], input[type=number], select, textarea { width: 100%; min-height: 48px; padding: 10px 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; }
input[type=file] { width: 100%; padding: 10px; background: var(--paper); border: 1px dashed var(--accent); border-radius: 8px; }
textarea { min-height: 84px; resize: vertical; }
.seg { display: flex; gap: 8px; }
.seg label { flex: 1; margin: 0; }
.seg input { position: absolute; opacity: 0; pointer-events: none; }
.seg span { display: block; text-align: center; padding: 12px 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); cursor: pointer; font-weight: 500; }
.seg input:checked + span { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
.btn { width: 100%; min-height: 50px; border: 0; border-radius: 8px; background: var(--accent); color: var(--accent-ink); font-weight: 600; cursor: pointer; }
.btn:disabled { opacity: .55; cursor: default; }
.btn.alt { background: transparent; color: var(--ink); border: 1px solid var(--line); }
.btn.danger { background: var(--danger); color: #fff; }
.err { color: var(--danger); min-height: 1.4em; margin: 8px 0 0; }

.once { border: 2px solid var(--brass); border-radius: 10px; padding: 16px; margin-bottom: 18px; background: var(--surface); }
.once .code { font-family: "Noto Serif Bengali", serif; font-size: 2.4rem; letter-spacing: .3em; font-weight: 700; text-align: center; padding: 8px 0; font-variant-numeric: tabular-nums; }

.list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
.list li { padding: 14px 2px; border-bottom: 1px solid var(--line); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
.list .avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: var(--line); }
.list .details { flex: 1; min-width: 200px; }
.list .name { font-weight: 600; }
.list .sub { color: var(--muted); font-size: .92rem; display: flex; flex-wrap: wrap; gap: 2px 14px; margin-top: 2px; }
.tag { font-size: .8rem; padding: 1px 8px; border-radius: 99px; border: 1px solid var(--line); margin-left: 8px; font-weight: 400; color: var(--muted); }
.tag.fixed { border-color: var(--accent); color: var(--accent); }
.empty { color: var(--muted); padding: 18px 2px; }
.actions { display: flex; gap: 8px; flex-wrap: wrap; width: 100%; margin-top: 8px; }

.login { max-width: 420px; margin: 0 auto; padding: 48px 16px 24px; }
.login h1 { font-size: 2rem; margin-bottom: 4px; }
.login p.lead { color: var(--muted); margin: 0 0 24px; }
details.setup { margin: 4px 0 16px; }
details.setup summary { cursor: pointer; color: var(--muted); padding: 8px 0; min-height: 44px; }

.mini { min-height: 36px; padding: 4px 12px; border: 1px solid var(--accent); background: transparent; color: var(--accent); border-radius: 6px; font-weight: 600; cursor: pointer; white-space: nowrap; font-size: 0.9rem; }
.mini.danger { border-color: var(--danger); color: var(--danger); }

.multi-month-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
.multi-month-table th, .multi-month-table td { padding: 8px 4px; text-align: left; border-bottom: 1px solid var(--line); }
.multi-month-table input { min-height: 40px; padding: 6px 8px; }
.multi-month-table th:last-child, .multi-month-table td:last-child { text-align: right; }
.total-row { font-weight: bold; border-top: 2px solid var(--ink); }

nav.tabs { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: var(--surface); border-top: 1px solid var(--line); padding-bottom: env(safe-area-inset-bottom, 0px); z-index: 5; }
nav.tabs button { flex: 1; min-height: 60px; border: 0; background: none; color: var(--muted); font-weight: 500; cursor: pointer; border-top: 3px solid transparent; }
nav.tabs button[aria-current="page"] { color: var(--accent); border-top-color: var(--accent); }

.toast { position: fixed; left: 16px; right: 16px; bottom: calc(80px + env(safe-area-inset-bottom, 0px)); max-width: 528px; margin: 0 auto; background: var(--ink); color: var(--paper); padding: 12px 16px; border-radius: 8px; z-index: 10; }
.toast.bad { background: var(--danger); color: #fff; }
</style>
</head>
<body>

<main id="loginView" class="login">
  <h1>আর-রাবেতা</h1>
  <p class="lead">অ্যাডমিন লগইন</p>
  <form id="loginForm" autocomplete="on">
    <div class="field">
      <label for="email">ইমেইল</label>
      <input id="email" type="email" autocomplete="username" required>
    </div>
    <div class="field">
      <label for="password">পাসওয়ার্ড</label>
      <input id="password" type="password" autocomplete="current-password" required>
    </div>
    <details class="setup" id="setup">
      <summary>প্রথমবার ব্যবহার? Publishable key দিন</summary>
      <div class="field">
        <label for="key">Publishable key</label>
        <input id="key" type="text" autocomplete="off" spellcheck="false">
      </div>
    </details>
    <button class="btn" id="loginBtn" type="submit">লগইন করুন</button>
    <p class="err" id="loginErr" role="alert"></p>
  </form>
</main>

<div id="appView" hidden>
  <div class="wrap">
    <header class="top">
      <div class="brand">আর-রাবেতা<small>হিসাব ব্যবস্থাপনা</small></div>
      <button class="link-btn" id="logoutBtn" type="button">লগআউট</button>
    </header>

    <!-- হিসাব -->
    <section id="tab-summary" aria-label="হিসাব">
      <h2>সোসাইটির হিসাব</h2>
      <div class="ledger">
        <div class="row"><span>মোট জমা</span><span class="num" id="sDeposit">–</span></div>
        <div class="row"><span>মোট খরচ</span><span class="num" id="sExpense">–</span></div>
        <div class="row"><span>মোট বিনিয়োগ</span><span class="num" id="sInvest">–</span></div>
        <div class="row total"><span>হাতে থাকা ব্যালেন্স</span><span class="num" id="sBalance">–</span></div>
        <p class="ledger-note" id="sMembers"></p>
      </div>
      <button class="btn alt" id="refreshBtn" type="button">হিসাব নতুন করে দেখুন</button>
    </section>

    <!-- লেনদেন -->
    <section id="tab-tx" aria-label="লেনদেন" hidden>
      <h2>নতুন লেনদেন</h2>
      <div class="once" id="txResult" hidden>
        <h3>লেনদেন সংরক্ষণ হয়েছে</h3>
        <p>রসিদ নম্বর: <strong id="txReceipt"></strong></p>
        <button class="btn alt" id="txOpen" type="button">রসিদ দেখুন ও PDF করুন</button>
      </div>
      <form class="panel" id="txForm" novalidate>
        <div class="field">
          <span class="lbl">ধরন</span>
          <div class="seg" role="radiogroup">
            <label><input type="radio" name="ttype" value="deposit" checked><span>জমা</span></label>
            <label><input type="radio" name="ttype" value="expense"><span>খরচ</span></label>
            <label><input type="radio" name="ttype" value="investment"><span>বিনিয়োগ</span></label>
          </div>
        </div>
        
        <div class="field" id="fMember">
          <label for="tMember">সদস্য</label>
          <select id="tMember"></select>
        </div>

        <div class="field" id="fDepositType">
          <span class="lbl">জমার ধরন</span>
          <div class="seg" role="radiogroup">
            <label><input type="radio" name="dtype" value="single" checked><span>এক মাসের</span></label>
            <label><input type="radio" name="dtype" value="multi"><span>একাধিক মাসের</span></label>
          </div>
        </div>

        <div id="singleMonthBox">
          <div class="field">
            <label for="tMonth">কোন মাসের জমা</label>
            <input id="tMonth" type="month">
          </div>
        </div>

        <div id="multiMonthBox" hidden>
          <div class="field">
            <label>মাস এবং টাকার পরিমাণ</label>
            <table class="multi-month-table" id="multiMonthTable">
              <thead><tr><th>Month & Year</th><th>Amount (৳)</th></tr></thead>
              <tbody></tbody>
              <tfoot><tr class="total-row"><td>Total</td><td id="multiTotal">৳ 0</td></tr></tfoot>
            </table>
            <button type="button" class="btn alt" id="addMonthBtn" style="margin-top:10px; min-height:40px;">+ নতুন মাস যোগ করুন</button>
          </div>
        </div>

        <div class="field" id="fCategory" hidden>
          <label for="tCategory" id="tCategoryLbl">খরচের খাত</label>
          <input id="tCategory" type="text" maxlength="80">
        </div>
        
        <div class="field">
          <label for="tAmount">মোট টাকার পরিমাণ</label>
          <input id="tAmount" type="text" inputmode="decimal" autocomplete="off" readonly style="background:var(--line); font-weight:bold;">
        </div>
        <div class="field">
          <label for="tDate">তারিখ</label>
          <input id="tDate" type="date">
        </div>
        <div class="field">
          <label for="tDesc">বিবরণ</label>
          <textarea id="tDesc" maxlength="500"></textarea>
        </div>
        <div class="field">
          <label for="tRef">রেফারেন্স (না থাকলে ফাঁকা রাখুন)</label>
          <input id="tRef" type="text" maxlength="120">
        </div>
        <button class="btn" id="txBtn" type="submit">লেনদেন সংরক্ষণ করুন</button>
        <p class="err" id="txErr" role="alert"></p>
      </form>

      <h3 style="margin:6px 0 10px">সাম্প্রতিক লেনদেন</h3>
      <ul class="list" id="txList"></ul>
    </section>

    <!-- সদস্য -->
    <section id="tab-members" aria-label="সদস্য" hidden>
      <h2>সদস্য</h2>
      <div class="once" id="codeBox" hidden>
        <h3 id="codeTitle"></h3>
        <div class="code" id="codeVal" aria-live="polite"></div>
        <p id="codeNote"></p>
        <button class="btn alt" id="copyCode" type="button">কোড কপি করুন</button>
      </div>
      <details class="panel" id="memberPanel">
        <summary><strong id="memberFormTitle">নতুন সদস্য যোগ করুন</strong></summary>
        <form id="memberForm" novalidate style="margin-top:14px">
          <input type="hidden" id="mId">
          <div class="field">
            <label for="mPhoto">সদস্যের ছবি (সর্বোচ্চ ১ MB)</label>
            <input id="mPhoto" type="file" accept="image/jpeg,image/png,image/webp">
            <p class="hint" id="mPhotoHint" hidden>নতুন ছবি দিলে পুরনোটি বদলে যাবে। না দিলে পুরনোটি থাকবে।</p>
          </div>
          <div class="field">
            <label for="mName">পূর্ণ নাম</label>
            <input id="mName" type="text" maxlength="120" autocomplete="off">
          </div>
          <div class="field">
            <span class="lbl">সদস্যের ধরন</span>
            <div class="seg" role="radiogroup">
              <label><input type="radio" name="mtype" value="fixed" checked><span>স্থায়ী</span></label>
              <label><input type="radio" name="mtype" value="other"><span>অন্যান্য</span></label>
            </div>
          </div>
          <div class="field">
            <label for="mPhone">ফোন নম্বর</label>
            <input id="mPhone" type="tel" autocomplete="off">
          </div>
          <div class="field">
            <label for="mAddress">ঠিকানা</label>
            <input id="mAddress" type="text" autocomplete="off">
          </div>
          <div class="field">
            <label for="mJob">পেশা</label>
            <input id="mJob" type="text" autocomplete="off">
          </div>
          <div class="field">
            <label for="mSavings">মাসিক সঞ্চয় (টাকা)</label>
            <input id="mSavings" type="text" inputmode="decimal" autocomplete="off">
          </div>
          <div class="field">
            <label for="mJoin">যোগদানের তারিখ</label>
            <input id="mJoin" type="date">
          </div>
          <button class="btn" id="mBtn" type="submit">সদস্য সংরক্ষণ করুন</button>
          <p class="err" id="mErr" role="alert"></p>
        </form>
      </details>
      <h3 style="margin:6px 0 10px">সদস্য তালিকা</h3>
      <ul class="list" id="memberList"></ul>
    </section>
  </div>

  <nav class="tabs" aria-label="প্রধান মেনু">
    <button type="button" data-tab="summary" aria-current="page">হিসাব</button>
    <button type="button" data-tab="tx">লেনদেন</button>
    <button type="button" data-tab="members">সদস্য</button>
  </nav>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

